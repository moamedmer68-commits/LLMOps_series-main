/*
 * LLMOps Test-Only Pipeline (Windows Version)
 * 
 * This pipeline runs tests on every push without requiring Azure credentials.
 * Fully adapted for Windows Jenkins nodes.
 */

pipeline {
    agent any
    
    environment {
        // Python settings - Using semicolon for Windows paths
        PYTHON_VERSION = '3.12'
        PYTHONPATH = "${WORKSPACE};${WORKSPACE}\\multi_doc_chat"
        
        // API Keys (Will be injected by Jenkins Credentials if configured)
        GROQ_API_KEY = "${env.GROQ_API_KEY ?: ''}"
        GOOGLE_API_KEY = "${env.GOOGLE_API_KEY ?: ''}"
        LLM_PROVIDER = "${env.LLM_PROVIDER ?: 'groq'}"
        
        // LangSmith Integration for Jenkins
        LANGSMITH_API_KEY = "${env.LANGSMITH_API_KEY ?: ''}"
        LANGCHAIN_TRACING_V2 = "true"
        LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
        LANGSMITH_PROJECT = "LLMOps_series-main"
    }
    
    triggers {
        // Poll SCM approximately every minute
        pollSCM('* * * * *')
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📦 Checking out code from repository...'
                checkout scm
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                echo '🐍 Setting up Python virtual environment (Windows)...'
                bat '''
                    @echo off
                    :: Create a virtual environment inside the Jenkins workspace
                    python -m venv venv
                    
                    :: Activate and prepare pip & uv
                    call venv\\Scripts\\activate.bat
                    python -m pip install --upgrade pip
                    pip install uv
                    
                    :: Show versions for debugging
                    python --version
                    uv --version
                '''
            }
        }
        
        stage('Install Dependencies') {
            steps {
                echo '📥 Installing project dependencies...'
                bat '''
                    @echo off
                    call venv\\Scripts\\activate.bat
                    
                    :: Sanitize requirements using inline Python (Alternative to Linux sed)
                    python -c "import re; lines = open('requirements.txt', encoding='utf-8').read().splitlines(); clean = [l for l in lines if not re.match(r'^[ \\t]*(llmops-series|pywin32)(==.*)?$', l)]; open('requirements_clean.txt', 'w', encoding='utf-8').write('\\n'.join(clean))"
                    
                    :: Install dependencies using uv for maximum speed
                    uv pip install -r requirements_clean.txt
                    
                    :: Ensure test tooling is available
                    uv pip install pytest pytest-cov
                    
                    echo Using PYTHONPATH=%PYTHONPATH% for local package imports
                '''
            }
        }
        
        stage('Run Tests') {
            steps {
                echo '🧪 Running pytest tests...'
                // catchError ensures test results are archived even if tests fail
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    bat '''
                        @echo off
                        call venv\\Scripts\\activate.bat
                        if not exist test-results mkdir test-results
                        
                        :: Use caret (^) for multiline commands in Windows Batch
                        pytest tests/ ^
                            --verbose ^
                            --junit-xml=test-results/results.xml ^
                            --cov=multi_doc_chat ^
                            --cov-report=xml:coverage.xml ^
                            --cov-report=html:htmlcov ^
                            --cov-report=term
                    '''
                }
                
                echo '📊 Archiving test results...'
                junit allowEmptyResults: true, testResults: 'test-results/*.xml'
                archiveArtifacts artifacts: 'coverage.xml,htmlcov/**,test-results/**/*.xml', allowEmptyArchive: true
            }
        }
    }
    
    post {
        success {
            echo '✅ Pipeline completed successfully! 🎉'
            echo '📊 Test results and coverage reports have been archived.'
        }
        
        failure {
            echo '❌ Pipeline failed!'
            echo 'Check the console output above for error details.'
        }
        
        always {
            echo '🧹 Cleaning up virtual environment...'
            bat '''
                @echo off
                if exist venv rmdir /s /q venv
                if exist requirements_clean.txt del requirements_clean.txt
            '''
            echo '💡 Pipeline execution finished.'
        }
    }
}